@model ADStoreBackend.Models.PaginatedViewModel<ADStoreBackend.Models.EntradaStockDto>
@{
    ViewData["Title"] = "Entradas de Stock";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Entradas de Stock</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nueva entrada</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Proveedor</th>
            <th>Fecha</th>
            <th>Nro Documento</th>
            <th>Monto Total</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model.Items)
        {
            <tr>
                <td>@e.EntradaStockId</td>
                <td>@e.ProveedorNombre</td>
                <td>@e.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@e.NumeroDocumento</td>
                <td>$@e.MontoTotal.ToString("N2")</td>
                <td>
                    <a asp-action="Detalle" asp-route-id="@e.EntradaStockId" class="btn btn-sm btn-info text-white">Ver
                        detalle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="_Paginacion" model="Model" />