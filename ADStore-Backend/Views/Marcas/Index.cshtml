@{
    ViewData["Title"] = "Marcas";
}

<div id="app">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Marcas</h2>
        <button class="btn btn-primary" @@click="abrirModalNuevo">+ Nueva marca</button>
    </div>

    <div v-if="error" class="alert alert-danger alert-dismissible">
        {{ error }}
        <button type="button" class="btn-close" @@click="error=null"></button>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <tr v-if="cargando">
                <td colspan="4" class="text-center py-3">
                    <div class="spinner-border spinner-border-sm"></div> Cargando...
                </td>
            </tr>
            <tr v-else-if="marcas.length === 0">
                <td colspan="4" class="text-center text-muted">No hay marcas registradas.</td>
            </tr>
            <tr v-for="m in marcas" :key="m.id">
                <td>{{ m.id }}</td>
                <td>{{ m.nombre }}</td>
                <td>
                    <span :class="m.activo ? 'badge bg-success' : 'badge bg-secondary'">
                        {{ m.activo ? 'Activo' : 'Inactivo' }}
                    </span>
                </td>
                <td>
                    <button class="btn btn-sm btn-warning me-1" @@click="abrirModalEditar(m)">Editar</button>
                    <button class="btn btn-sm btn-danger" @@click="confirmarEliminar(m)">Eliminar</button>
                </td>
            </tr>
        </tbody>
    </table>

    <!-- Paginación -->
    <nav v-if="totalPaginas > 1">
        <ul class="pagination justify-content-center">
            <li class="page-item" :class="{ disabled: paginaActual === 1 }">
                <a class="page-link" href="#" @@click.prevent="cargarPagina(paginaActual - 1)">«</a>
            </li>
            <li v-for="p in totalPaginas" :key="p" class="page-item" :class="{ active: p === paginaActual }">
                <a class="page-link" href="#" @@click.prevent="cargarPagina(p)">{{ p }}</a>
            </li>
            <li class="page-item" :class="{ disabled: paginaActual === totalPaginas }">
                <a class="page-link" href="#" @@click.prevent="cargarPagina(paginaActual + 1)">»</a>
            </li>
        </ul>
    </nav>

    <!-- Modal Crear/Editar -->
    <div class="modal fade" id="modalMarca" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ form.id ? 'Editar marca' : 'Nueva marca' }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div v-if="errorModal" class="alert alert-danger py-2">{{ errorModal }}</div>
                    <div class="mb-3">
                        <label class="form-label">Nombre *</label>
                        <input v-model="form.nombre" type="text" class="form-control"
                               :class="{ 'is-invalid': errores.nombre }" maxlength="100" />
                        <div class="invalid-feedback">{{ errores.nombre }}</div>
                    </div>
                    <div class="form-check">
                        <input v-model="form.activo" class="form-check-input" type="checkbox" id="chkActivo" />
                        <label class="form-check-label" for="chkActivo">Activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @@click="guardar" :disabled="guardando">
                        <span v-if="guardando" class="spinner-border spinner-border-sm me-1"></span>
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Confirmar Eliminar -->
    <div class="modal fade" id="modalEliminar" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    ¿Eliminar la marca <strong>{{ marcaAEliminar?.nombre }}</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @@click="eliminar" :disabled="eliminando">
                        <span v-if="eliminando" class="spinner-border spinner-border-sm me-1"></span>
                        Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@@3/dist/vue.global.prod.js"></script>
    <script>
        const { createApp } = Vue;

        createApp({
        data() {
        return {
        marcas: [],
        paginaActual: 1,
        totalPaginas: 1,
        cargando: false,
        error: null,
        form: { id: 0, nombre: '', activo: true },
        errores: {},
        errorModal: null,
        guardando: false,
        marcaAEliminar: null,
        eliminando: false,
        modalMarca: null,
        modalEliminar: null,
        };
        },
        mounted() {
        this.modalMarca = new bootstrap.Modal(document.getElementById('modalMarca'));
        this.modalEliminar = new bootstrap.Modal(document.getElementById('modalEliminar'));
        this.cargarPagina(1);
        },
        methods: {
        async cargarPagina(pagina) {
        if (pagina < 1 || pagina > this.totalPaginas && this.totalPaginas > 0) return;
        this.cargando = true;
        this.error = null;
        try {
        const res = await fetch(`/Marcas/Lista?page=${pagina}&pageSize=10`);
        if (!res.ok) throw new Error('Error al cargar marcas');
        const data = await res.json();
        this.marcas = data.items;
        this.paginaActual = data.paginaActual;
        this.totalPaginas = data.totalPaginas;
        } catch (e) {
        this.error = e.message;
        } finally {
        this.cargando = false;
        }
        },
        abrirModalNuevo() {
        this.form = { id: 0, nombre: '', activo: true };
        this.errores = {};
        this.errorModal = null;
        this.modalMarca.show();
        },
        abrirModalEditar(marca) {
        this.form = { id: marca.id, nombre: marca.nombre, activo: marca.activo };
        this.errores = {};
        this.errorModal = null;
        this.modalMarca.show();
        },
        validar() {
        this.errores = {};
        if (!this.form.nombre.trim()) this.errores.nombre = 'El nombre es obligatorio';
        return Object.keys(this.errores).length === 0;
        },
        async guardar() {
        if (!this.validar()) return;
        this.guardando = true;
        this.errorModal = null;
        try {
        const res = await fetch('/Marcas/Guardar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(this.form)
        });
        if (!res.ok) {
        const err = await res.json();
        this.errorModal = err.mensaje ?? 'Error al guardar';
        return;
        }
        this.modalMarca.hide();
        await this.cargarPagina(this.paginaActual);
        } catch {
        this.errorModal = 'Error de conexión';
        } finally {
        this.guardando = false;
        }
        },
        confirmarEliminar(marca) {
        this.marcaAEliminar = marca;
        this.modalEliminar.show();
        },
        async eliminar() {
        this.eliminando = true;
        try {
        const res = await fetch(`/Marcas/Eliminar?id=${this.marcaAEliminar.id}`, { method: 'DELETE' });
        if (!res.ok) {
        const err = await res.json();
        this.error = err.mensaje ?? 'Error al eliminar';
        }
        this.modalEliminar.hide();
        // Si era el último elemento de la página, retroceder
        const paginaDestino = this.marcas.length === 1 && this.paginaActual > 1
        ? this.paginaActual - 1
        : this.paginaActual;
        await this.cargarPagina(paginaDestino);
        } catch {
        this.error = 'Error de conexión';
        } finally {
        this.eliminando = false;
        }
        }
        }
        }).mount('#app');
    </script>
}