@model ADStoreBackend.Models.PaginatedViewModel<ADStoreBackend.Models.CategoriaDto>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categorías</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nueva categoría</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Items)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Nombre</td>
                <td>
                    <span class="badge @(c.Activo ? "bg-success" : "bg-secondary")">
                        @(c.Activo ? "Activo" : "Inactivo")
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Editar</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar @c.Nombre?')">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Paginacion" model="Model" />