@model ADStoreBackend.Models.CategoriaFormViewModel
@{
    ViewData["Title"] = "Nueva categoría";
}

<h2>Nueva categoría</h2>
<hr />

<form asp-action="Create" method="post" style="max-width: 500px;">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="Activo" class="form-check-input" />
        <label asp-for="Activo" class="form-check-label">Activo</label>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
</form>