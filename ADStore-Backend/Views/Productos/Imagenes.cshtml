@model ADStoreBackend.Models.ProductoDto
@{
    ViewData["Title"] = "Imágenes — " + Model.Nombre;
    var apiBase = "https://localhost:7272";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Imágenes de @Model.Nombre</h2>
    <a asp-action="Index" class="btn btn-secondary">← Volver</a>
</div>

<div class="card mb-4" style="max-width:500px;">
    <div class="card-body">
        <h5 class="card-title">Subir nueva imagen</h5>
        <form asp-action="SubirImagen" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <input type="file" name="imagen" accept="image/jpeg,image/png,image/webp" class="form-control"
                       required />
                <div class="form-text">JPG, PNG o WEBP. Máximo 2MB.</div>
            </div>
            <button type="submit" class="btn btn-primary">Subir</button>
        </form>
    </div>
</div>

@if (Model.Imagenes.Any())
{
    <div class="row g-3">
        @foreach (var img in Model.Imagenes)
        {
            <div class="col-6 col-md-3">
                <div class="card h-100">
                    <img src="@(img.UrlImagen)" class="card-img-top" style="height:160px;object-fit:cover;" />
                    <div class="card-body p-2 d-flex flex-column gap-2">
                        @if (img.EsPrincipal)
                        {
                            <span class="badge bg-success w-100 text-center">Principal ✓</span>
                        }
                        else
                        {
                            <form asp-action="MarcarPrincipal" asp-route-id="@Model.Id" asp-route-imagenId="@img.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-success w-100">Marcar principal</button>
                            </form>
                        }
                        <form asp-action="EliminarImagen" asp-route-id="@Model.Id" asp-route-imagenId="@img.Id" method="post"
                              onsubmit="return confirm('¿Eliminar esta imagen?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Eliminar</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">Este producto no tiene imágenes aún.</p>
}