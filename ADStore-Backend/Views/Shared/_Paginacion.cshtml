@model ADStoreBackend.Models.IPaginationInfo

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación" class="mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">
                Mostrando @((Model.PaginaActual - 1) * Model.PorPagina + 1)–@(Math.Min(Model.PaginaActual * Model.PorPagina,
                            Model.TotalItems))
                de @Model.TotalItems registros
            </small>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.PaginaActual - 1)">‹</a>
                </li>

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    @if (i == 1 || i == Model.TotalPaginas || (i >= Model.PaginaActual - 2 && i <= Model.PaginaActual + 2))
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" href="?page=@i">@i</a>
                        </li>
                    }
                    else if (i == Model.PaginaActual - 3 || i == Model.PaginaActual + 3)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }

                <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.PaginaActual + 1)">›</a>
                </li>
            </ul>
        </div>
    </nav>
}
