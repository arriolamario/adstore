{
  "info": {
    "name": "AD Moda & Confort — API",
    "description": "Coleccion para probar la API a mano. Ver postman/README.md para como importarla y usarla.\n\nFlujo tipico: correr 'Login (admin)' primero (guarda el token solo) y despues cualquier otro request, en cualquier orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar comprador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Postman\",\n  \"email\": \"cliente-postman@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('userId', body.id);",
              "}"
            ] }
          }]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@adstore.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('login ok', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('token', body.token);",
              "console.log('Token guardado para el resto de la coleccion.');"
            ] }
          }]
        },
        {
          "name": "Sesion actual (/me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar (publico)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          }
        },
        {
          "name": "Crear (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zapatilla Postman\",\n  \"brand\": \"Test\",\n  \"category\": \"Zapatillas\",\n  \"price\": 15000,\n  \"availability\": \"stock\",\n  \"sizes\": [\"40\", \"41\"],\n  \"stock\": { \"40\": 5, \"41\": 3 },\n  \"image\": \"\",\n  \"description\": \"Producto de prueba creado desde Postman\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('productId', pm.response.json().id);",
              "}"
            ] }
          }]
        },
        {
          "name": "Editar (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zapatilla Postman (editada)\",\n  \"brand\": \"Test\",\n  \"category\": \"Zapatillas\",\n  \"price\": 16000,\n  \"availability\": \"stock\",\n  \"sizes\": [\"40\", \"41\"],\n  \"stock\": { \"40\": 4, \"41\": 3 },\n  \"image\": \"\",\n  \"description\": \"Editado desde Postman\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
          }
        },
        {
          "name": "Eliminar (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
          }
        },
        {
          "name": "Restaurar catalogo semilla (admin)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/products/reset", "host": ["{{baseUrl}}"], "path": ["api", "products", "reset"] }
          }
        }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        {
          "name": "Listar (publico)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          }
        },
        {
          "name": "Crear (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Categoria Postman\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('categoryId', pm.response.json().id);",
              "}"
            ] }
          }]
        },
        {
          "name": "Renombrar (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Categoria Postman (renombrada)\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}"] }
          }
        },
        {
          "name": "Eliminar (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}"] }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar todos (admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Ver uno (propio o admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] }
          }
        },
        {
          "name": "Crear (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Postman\",\n  \"email\": \"usuario-postman@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"customer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('userId', pm.response.json().id);",
              "}"
            ] }
          }]
        },
        {
          "name": "Editar (propio o admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"1155555555\",\n  \"address\": \"Calle Falsa 123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] }
          }
        },
        {
          "name": "Eliminar (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "Reservas",
      "item": [
        {
          "name": "Listar (propias o todas si sos admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Crear reserva",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fulfillment\": \"pickup\",\n  \"customer\": {\n    \"name\": \"Cliente Postman\",\n    \"phone\": \"1155555555\",\n    \"email\": \"cliente-postman@example.com\"\n  },\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"name\": \"Zapatilla Postman\",\n      \"brand\": \"Test\",\n      \"price\": 15000,\n      \"image\": \"\",\n      \"availability\": \"stock\",\n      \"size\": \"40\",\n      \"qty\": 1\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('orderId', pm.response.json().id);",
              "}"
            ] }
          }]
        },
        {
          "name": "Cambiar estado (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"preparando\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}", "status"] }
          }
        },
        {
          "name": "Eliminar (admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] }
          }
        }
      ]
    }
  ]
}
