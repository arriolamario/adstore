# Copia a .env (base de desarrollo local) y completa DATABASE_URL.
# Con PostgreSQL instalado localmente (ver README > "Base de datos local"):
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/adstore_dev
PORT=3001

# Clave para firmar las cookies de sesion (JWT). Generala vos, no reuses esta.
# Ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-una-clave-larga-y-aleatoria

# Para tests de integracion (npm run test:integration) se usa un archivo
# aparte, .env.test, con su propia base y su propio JWT_SECRET (no se
# comparte con .env):
#   DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/adstore_test
#   PORT=3002
#   JWT_SECRET=otra-clave-distinta-de-la-de-arriba

# Si preferis apuntar a Postgres en la nube (ej. Neon) en vez de local:
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
